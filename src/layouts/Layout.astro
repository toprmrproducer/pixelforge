---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
}

const { title, description, canonicalPath = '/' } = Astro.props;
const siteUrl = 'https://toprmrproducer.github.io';
const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base : `${base}/`;
const canonical = new URL(
	`${normalizedBase}${canonicalPath.replace(/^\//, '')}`,
	siteUrl,
).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${normalizedBase}favicon.svg`} />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Sora:wght@700;800&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<style>
			/*
				Reserved AdSense slots. They occupy NO visible space until a real
				<ins class="adsbygoogle"> is dropped inside — an empty dashed
				"Advertisement" box can hurt AdSense approval, so unfilled slots
				collapse to zero height and show no border/label. Once populated
				they reserve their declared min-height to avoid layout shift.
			*/
			.ad-slot:empty {
				min-height: 0 !important;
				height: 0;
				overflow: hidden;
			}
			.ad-leaderboard {
				width: 100%;
			}
			.ad-skyscraper {
				width: 160px;
			}
		</style>
	</head>
	<body class="min-h-screen bg-white text-[#4A4234] antialiased">
		<header class="border-b border-[#EAE4D6]">
			<nav
				class="mx-auto flex max-w-[820px] items-center justify-between px-6 py-5"
			>
				<a
					href={normalizedBase}
					class="font-[Sora] text-xl font-extrabold tracking-tight text-[#221B10]"
				>
					Pixel<span class="text-[#C9982E]">Forge</span>
				</a>
				<div class="flex items-center gap-2 text-[15px] font-semibold text-[#4A4234]">
					<a
						href={`${normalizedBase}about`}
						class="rounded-lg px-3 py-2.5 transition hover:text-[#C9982E]">About</a
					>
					<a
						href={`${normalizedBase}faq`}
						class="rounded-lg px-3 py-2.5 transition hover:text-[#C9982E]">FAQ</a
					>
				</div>
			</nav>
		</header>

		<!--
			Ad-ready layout: the single content column is hard-capped at 820px and
			centered, leaving genuinely empty left/right gutters (~310px each at
			1440px) for future AdSense units. The pt/pb on <main> and the mt on
			<footer> create the vertical breathing zones above/below the content.
			Do not fill these spaces with decoration.
		-->

		<!-- Top leaderboard ad slot (invisible until a real <ins> is dropped in) -->
		<div
			class="ad-slot ad-leaderboard mx-auto"
			data-ad-slot="leaderboard"
			style="max-width:970px;min-height:0"
		>
			<!-- AdSense: paste responsive <ins class="adsbygoogle"> here -->
		</div>

		<!--
			Three-column ad-ready row: [left skyscraper][820px content][right
			skyscraper]. The two skyscraper asides sit in the empty gutters and are
			shown ONLY at >=1280px (hidden xl:block); on smaller screens the content
			column simply centers as before. The asides are sticky so they track the
			viewport as the page scrolls.
		-->
		<div class="mx-auto flex max-w-[1240px] items-start justify-center gap-6 px-6">
			<aside
				class="ad-slot ad-skyscraper sticky top-[120px] hidden shrink-0 xl:block"
				data-ad-slot="skyscraper-left"
				style="min-height:0"
			>
				<!-- AdSense: paste responsive <ins class="adsbygoogle"> here -->
			</aside>

			<main class="w-full max-w-[820px] pt-24 pb-28">
				<slot />
			</main>

			<aside
				class="ad-slot ad-skyscraper sticky top-[120px] hidden shrink-0 xl:block"
				data-ad-slot="skyscraper-right"
				style="min-height:0"
			>
				<!-- AdSense: paste responsive <ins class="adsbygoogle"> here -->
			</aside>
		</div>

		<!-- Bottom in-article ad slot (invisible until a real <ins> is dropped in) -->
		<div
			class="ad-slot mx-auto px-6"
			data-ad-slot="in-article"
			style="max-width:728px;min-height:0"
		>
			<!-- AdSense: paste responsive <ins class="adsbygoogle"> here -->
		</div>

		<footer class="mt-24 border-t border-[#EAE4D6]">
			<div class="mx-auto max-w-[820px] px-6 py-12 text-[15px] text-[#4A4234]">
				<p>
					All conversions run locally in your browser. Nothing you upload is
					ever sent to a server.
				</p>
				<div class="mt-5 flex flex-wrap gap-x-8 gap-y-2">
					<a
						href={`${normalizedBase}about`}
						class="py-1.5 font-medium transition hover:text-[#C9982E]">About</a
					>
					<a
						href={`${normalizedBase}privacy`}
						class="py-1.5 font-medium transition hover:text-[#C9982E]"
						>Privacy Policy</a
					>
					<a
						href={`${normalizedBase}faq`}
						class="py-1.5 font-medium transition hover:text-[#C9982E]">FAQ</a
					>
				</div>
				<p class="mt-5 text-sm text-[#8A7E68]">
					&copy; {new Date().getFullYear()} PixelForge
				</p>
			</div>
		</footer>
	</body>
</html>
